# Copy to a private .env; generate unique secrets before deployment.
RELAY_VERSION=relay-v3-dev
BIND_HOST=127.0.0.1
SERVER_PORT=8080
ADMIN_EMAIL=admin@relay.local
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
# Optional providers: configure both fields privately before OAuth login/refresh.
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
GEMINI_CLI_OAUTH_CLIENT_ID=
GEMINI_CLI_OAUTH_CLIENT_SECRET=
